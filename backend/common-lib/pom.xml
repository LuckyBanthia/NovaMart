<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  common-lib: Shared Domain Contracts, DTOs & Security Utils
  ============================================================================
  This library is compiled as a shared JAR and imported by:
  - user-service
  - product-service
  - order-service
  - gateway-service
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.novamart</groupId>
		<artifactId>novamart-platform</artifactId>
		<version>1.0.0</version>
	</parent>

	<artifactId>common-lib</artifactId>
	<packaging>jar</packaging>
	<name>common-lib</name>
	<description>Shared DTOs and Enums for NovaMart Microservices</description>

	<dependencies>
		<!-- Validation API for request DTO annotations (@NotBlank, @NotNull, etc.) -->
		<dependency>
			<groupId>jakarta.validation</groupId>
			<artifactId>jakarta.validation-api</artifactId>
		</dependency>

		<!-- Jackson annotations for JSON serialization -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
		</dependency>

		<!-- JJWT for token signing and verification -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<scope>runtime</scope>
		</dependency>
	</dependencies>
</project>
